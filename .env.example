# Exemple de configuration pour Kanban Ideas
# Copiez ce fichier en `.env` et adaptez les chemins/valeurs à votre environnement local.

# Workspace Kanban Ideas (facultatif)
# Indiquez un dossier existant qui contiendra les sous-dossiers d'idées.
# Par défaut l'application utilise <répertoire_du_projet>/data/ideas.
KANBAN_IDEAS_WORKSPACE=/chemin/vers/mon/workspace

# Configuration de Vibe (facultatif)
# VIBE_CLI peut pointer vers le binaire `vibe` si celui-ci n'est pas déjà dans votre PATH.
VIBE_CLI=/chemin/vers/vibe
# VIBE_MODEL_PATH doit pointer vers un modèle Whisper .bin téléchargé pour Vibe.
VIBE_MODEL_PATH=/chemin/vers/ggml-medium.bin
# Spécifiez la langue par défaut demandée à Vibe ("french", "english", etc.).
VIBE_LANGUAGE=french
# Nombre de threads utilisés par Vibe (laisser vide pour la valeur par défaut du binaire).
VIBE_THREADS=4
# Température transmise à Vibe pour l'inférence (laisser vide pour la valeur par défaut du binaire).
VIBE_TEMPERATURE=0.2
